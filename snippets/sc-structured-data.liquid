{%- comment -%}
  sc-structured-data.liquid — ScrumClub structured data (JSON-LD)

  Rendered once from layout/theme.liquid (inside the documented brand block).

  Emits:
    • Organization — homepage only. Enriches the bare Organization that
      Pitch's header.liquid outputs (which has no sameAs) with the brand
      name, canonical url, logo and the confirmed social profiles.
    • BreadcrumbList — product and collection pages
      (Home → Collection → Product / Home → Collection).

  Deliberately NOT emitted:
    • Product — Pitch's product-information section already renders
      {{ closest.product | structured_data }} (name, image, description,
      sku, brand from vendor, offers with GBP price + availability + url).
      Duplicating it here would create competing Product nodes.

  The sameAs URLs mirror the social-links block in sections/footer-group.json
  (the confirmed profiles). If a social profile is added or changed in the
  footer, update the list here too.
{%- endcomment -%}

{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "ScrumClub",
      "url": {{ request.origin | append: routes.root_url | json }},
      {%- if settings.logo %}
        "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
      {%- endif %}
      "sameAs": [
        "https://www.instagram.com/scrumchic",
        "https://www.tiktok.com/@scrumchic"
      ]
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'product' and product != blank -%}
  {%- liquid
    assign crumb_collection = collection | default: product.collections.first
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ request.origin | append: routes.root_url | json }}
        },
        {%- if crumb_collection != blank %}
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ crumb_collection.title | json }},
            "item": {{ request.origin | append: crumb_collection.url | json }}
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ product.title | json }},
            "item": {{ request.origin | append: product.url | json }}
          }
        {%- else %}
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ product.title | json }},
            "item": {{ request.origin | append: product.url | json }}
          }
        {%- endif %}
      ]
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'collection' and collection != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ request.origin | append: routes.root_url | json }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": {{ request.origin | append: collection.url | json }}
        }
      ]
    }
  </script>
{%- endif -%}
