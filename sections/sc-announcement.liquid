{%- comment -%}
  sc-announcement.liquid — top announcement strip (CLAUDE.md §3.4)
  ------------------------------------------------------------------
  Thin message bar (Made in UK · 5% · free shipping in the mock). Static,
  pipe-separated messages with separators. For a SITE-WIDE bar, add this
  to the header group in the editor; placed in index.json it shows on the
  homepage only.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign messages = s.text | split: '|'
-%}

<section class="sc-announce sc-announce--{{ s.surface }}" data-rotate-interval="{{ s.rotate_seconds | default: 4 }}">
  <div class="sc-wrap sc-announce__inner">
    {%- for message in messages -%}
      <span class="sc-announce__msg">{{ message | strip | escape }}</span>
      {%- unless forloop.last -%}<span class="sc-announce__sep" aria-hidden="true">·</span>{%- endunless -%}
    {%- endfor -%}
    {%- if s.promo_text != blank -%}
      {%- if messages.size > 0 -%}<span class="sc-announce__sep" aria-hidden="true">·</span>{%- endif -%}
      {%- if s.promo_link != blank -%}
        <a class="sc-announce__msg sc-announce__promo" href="{{ s.promo_link }}">{{ s.promo_text | strip | escape }}</a>
      {%- else -%}
        <span class="sc-announce__msg sc-announce__promo">{{ s.promo_text | strip | escape }}</span>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .sc-announce { width: 100%; }
  .sc-announce--pitch { background: var(--pitch); color: var(--paper); }
  .sc-announce--try { background: var(--try); color: var(--paper); }
  .sc-announce--paper { background: var(--paper); color: var(--pitch); border-bottom: 1px solid var(--bone); }
  .sc-announce__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--s-3);
    padding-block: 9px;
  }
  .sc-announce__msg {
    font-family: var(--font-action);
    font-weight: 800;
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 12px;
  }
  .sc-announce__sep { opacity: 0.5; }
  .sc-announce__promo { color: inherit; }
  a.sc-announce__promo { text-decoration: underline; text-underline-offset: 3px; }
  a.sc-announce__promo:hover { color: var(--try-bright); }
  /* Mobile: rotate one message at a time instead of stacking them all —
     the stacked bar eats too much viewport above the header. Messages
     overlay in a single grid cell (bar height = tallest message, so it
     never jumps); JS cycles .is-active. Enter rises from below, exit
     continues upward (--ease-kick reveal, no bounce, per §2 motion). */
  @media (max-width: 600px) {
    .sc-announce__sep { display: none; }
    .sc-announce__inner { display: grid; justify-content: stretch; padding-block: 8px; }
    .sc-announce__inner > .sc-announce__msg {
      grid-area: 1 / 1;
      text-align: center;
      opacity: 0;
      transform: translateY(7px);
      transition: opacity 360ms var(--ease-kick), transform 360ms var(--ease-kick);
      pointer-events: none;
    }
    .sc-announce__inner > .sc-announce__msg.is-active {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
    .sc-announce__inner > .sc-announce__msg.is-leaving { transform: translateY(-7px); }
    /* Before JS runs (or without it) the first message stays visible. */
    .sc-announce__inner:not(:has(.is-active)) > .sc-announce__msg:first-child {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
    @media (prefers-reduced-motion: reduce) {
      .sc-announce__inner > .sc-announce__msg { transition: none; transform: none; }
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('.sc-announce').forEach((bar) => {
    const msgs = Array.from(bar.querySelectorAll('.sc-announce__msg'));
    if (msgs.length < 2) return;
    const interval = (parseInt(bar.dataset.rotateInterval, 10) || 4) * 1000;
    let current = 0;
    msgs[0].classList.add('is-active');
    setInterval(() => {
      if (document.hidden) return;
      const leaving = msgs[current];
      current = (current + 1) % msgs.length;
      leaving.classList.remove('is-active');
      leaving.classList.add('is-leaving');
      setTimeout(() => leaving.classList.remove('is-leaving'), 400);
      msgs[current].classList.add('is-active');
    }, interval);
  });
{% endjavascript %}

{% schema %}
{
  "name": "SC Announcement",
  "tag": "section",
  "class": "sc-section sc-announce-section",
  "settings": [
    {
      "type": "select",
      "id": "surface",
      "label": "Surface",
      "options": [
        { "value": "pitch", "label": "Pitch (dark)" },
        { "value": "try", "label": "Try-red" },
        { "value": "paper", "label": "Paper (light)" }
      ],
      "default": "pitch"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Messages",
      "info": "Separate messages with a pipe ( | ).",
      "default": "MADE IN UK|5% OF EVERY ORDER FUNDS RESEARCH|FREE UK SHIPPING OVER £75"
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Promo message",
      "info": "Shown after the messages. CAPS per the type rules."
    },
    {
      "type": "url",
      "id": "promo_link",
      "label": "Promo link (optional)"
    },
    {
      "type": "range",
      "id": "rotate_seconds",
      "label": "Mobile rotation speed",
      "info": "Seconds each message shows on small screens. Desktop shows all messages inline.",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "s",
      "default": 4
    }
  ],
  "presets": [ { "name": "SC Announcement" } ]
}
{% endschema %}
